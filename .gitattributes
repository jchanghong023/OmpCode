# 保持脚本文件 LF 换行，避免 Windows CRLF 导致 shebang 解析失败
*.mjs text eol=lf
*.sh  text eol=lf

# oxfmt 检查的文本文件统一使用 LF，避免 Windows 检出为 CRLF 后整仓格式检查失败。
*.ts   text eol=lf
*.tsx  text eol=lf
*.mts  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.toml text eol=lf

# 上游许可原文与生成的声明按字节保存，不能自动转换换行或裁剪空白。
# 原文中的 License / ======= 是 Markdown 标题，不是合并冲突。
THIRD-PARTY-NOTICES.md -text -eol -whitespace conflict-marker-size=32 linguist-generated=true
third-party/upstream/** -text -eol -whitespace
third-party/native-search/licenses/** -text -eol -whitespace
third-party/runtime/*.txt -text -eol -whitespace
third-party/inventory.json linguist-generated=true
